// 驿书 V1 Prisma Schema
// Phase 4：Journey + TransportLeg 本地路线规划（对应开发规范 §54/§55）。
// 业务模型：User / Block / RefreshToken / Letter / RecipientState / SenderState / Journey / TransportLeg。
// WorldEvent / TimelineEvent 等在后续 Phase 引入。

generator client {
  provider               = "prisma-client"
  output                 = "../generated/prisma"
  engineType             = "client"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

// 运输方式（对应开发规范 §13）
enum TransportType {
  HAND_CARRY
  HORSE_RELAY
  EXPRESS_RELAY
  PIGEON
}

// Letter 状态（对应开发规范 §37）
enum LetterStatus {
  CREATED
  DISPATCHED
  IN_TRANSIT
  AT_STATION
  TRANSFER
  DELAYED
  COURIER_MISSING
  LETTER_DROPPED
  LETTER_MISSING
  RECOVERED
  TRANSPORT_CHANGED
  OUT_FOR_DELIVERY
  DELIVERED
  PERMANENTLY_LOST
  DESTROYED
}

// 收件人阅读状态（对应开发规范 §42）
enum RecipientReadState {
  UNOPENED
  OPENED
}

// Journey 状态（Phase 4：本地 Graph 路线规划；最小状态集，后续 Phase 扩展）
enum JourneyStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// TransportLeg 状态（Phase 4：仅规划；Phase 5：正常推进 PLANNED → ACTIVE → COMPLETED）
enum TransportLegStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

// 用户（对应开发规范 §52）
model User {
  id           BigInt   @id @default(autoincrement())
  uid          String   @unique
  account      String   @unique
  passwordHash String
  nickname     String

  province String
  city     String
  district String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 我拉黑的用户（对应规范 §10）
  blocks Block[] @relation("Blocker")
  // 拉黑我的用户
  blockedBy Block[] @relation("Blocked")

  refreshTokens RefreshToken[]

  sentLetters     Letter[] @relation("SentLetters")
  receivedLetters Letter[] @relation("ReceivedLetters")

  recipientStates RecipientState[]
  senderStates    SenderState[]
}

// 拉黑关系（对应规范 §10）
model Block {
  id        BigInt   @id @default(autoincrement())
  blockerId BigInt
  blockedId BigInt
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id])
  blocked User @relation("Blocked", fields: [blockedId], references: [id])

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

// Refresh Token（对应规范 §5：数据库只保存 Token Hash）
model RefreshToken {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// 信件（对应开发规范 §53）
model Letter {
  id         BigInt  @id @default(autoincrement())
  trackingNo String  @unique
  senderId   BigInt
  recipientId BigInt

  // 身份快照（规范 §11）
  senderAccountSnapshot    String
  senderUidSnapshot        String
  senderNicknameSnapshot   String
  recipientAccountSnapshot String
  recipientUidSnapshot     String
  recipientNicknameSnapshot String

  // 正文加密（规范 §48：AES-256-GCM）
  encryptedContent String
  contentIv        String
  contentAuthTag   String

  // 区域快照（规范 §53）
  originProvince  String
  originCity      String
  originDistrict  String
  targetProvince  String
  targetCity      String
  targetDistrict  String

  status           LetterStatus
  initialTransport TransportType
  currentTransport TransportType

  // 幂等（规范 §67）
  clientRequestId   String
  // 请求指纹（规范化 recipient UID + content + transportType 的 SHA-256）
  requestFingerprint String

  // 版本与 Seed（规范 §53/§63/§64）
  rulesVersion   String @default("1.0")
  graphVersion   String @default("china-v1")
  simulationSeed String

  sentAt     DateTime?
  deliveredAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sender    User @relation("SentLetters", fields: [senderId], references: [id])
  recipient User @relation("ReceivedLetters", fields: [recipientId], references: [id])

  recipientState RecipientState?
  senderState    SenderState?

  // Letter : Journey = 1 : 1（对应开发规范 §54 + Phase 4 Prompt §9）
  journey Journey?

  @@unique([senderId, clientRequestId])
  @@index([recipientId])
}

// 收件人状态（对应规范 §58）
model RecipientState {
  id          BigInt             @id @default(autoincrement())
  letterId    BigInt             @unique
  recipientId BigInt
  readState   RecipientReadState
  openedAt    DateTime?
  hiddenAt    DateTime?

  letter Letter @relation(fields: [letterId], references: [id], onDelete: Cascade)
  recipient User @relation(fields: [recipientId], references: [id])

  @@index([recipientId])
}

// 发件人状态（对应规范 §59）
model SenderState {
  id       BigInt   @id @default(autoincrement())
  letterId BigInt   @unique
  senderId BigInt
  hiddenAt DateTime?

  letter Letter @relation(fields: [letterId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id])

  @@index([senderId])
}

// Journey（Phase 4：本地 Graph 路线规划结果；对应开发规范 §54 + Phase 4 Prompt）
// Letter : Journey = 1 : 1，letterId 唯一约束作为并发竞态最终保障。
model Journey {
  id         BigInt @id @default(autoincrement())
  letterId   BigInt @unique
  originNodeId      String
  destinationNodeId String

  status JourneyStatus @default(PLANNED)

  // 继承 Letter 冻结值，Journey 不得自行生成（规范 §63/§64）
  rulesVersion   String
  graphVersion   String
  simulationSeed String

  totalDistanceKm Float

  // 模拟时间语义（Phase 5：SimulationClock.now() 写入，与 createdAt/updatedAt 真实审计时间区分）。
  // 时间倒退 / 重复推进契约：now <= lastAdvancedAtSim → no-op。
  startedAtSim       DateTime? // 运输开始（首个 Leg ACTIVE 的模拟时刻）
  completedAtSim     DateTime? // 运输完成（最后一个 Leg COMPLETED 的模拟时刻，到达目标站）
  lastAdvancedAtSim  DateTime? // 最近一次推进到的模拟时刻（幂等 / 倒退判定基准）
  currentLegSequence Int?      // 当前 ACTIVE Leg 的 sequence；无 ACTIVE（未开始或已全部完成）为 null

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  letter Letter         @relation(fields: [letterId], references: [id], onDelete: Cascade)
  legs   TransportLeg[]

  @@index([letterId])
}

// TransportLeg（Phase 4：路线分段；对应开发规范 §55 + Phase 4 Prompt）
// 仅表达规划结果，不含事件/掉落/疲劳等后续业务字段。
model TransportLeg {
  id         BigInt @id @default(autoincrement())
  journeyId  BigInt
  sequence   Int
  fromNodeId String
  toNodeId   String

  transportType TransportType
  distanceKm    Float

  // Simulation 内部输入（秒），用户 API 严禁暴露（规范 §18/§45）
  plannedDurationSeconds Int

  status TransportLegStatus @default(PLANNED)

  // 模拟时间语义（Phase 5：由 SimulationClock 驱动；completed 不可回退）。
  startedAtSim   DateTime? // Leg 开始运输的模拟时刻（ACTIVE 时设置）
  completedAtSim DateTime? // Leg 完成运输的模拟时刻（COMPLETED 时设置）

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  journey Journey @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@unique([journeyId, sequence])
  @@index([journeyId])
}

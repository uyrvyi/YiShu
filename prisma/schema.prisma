// 驿书 V1 Prisma Schema
// Phase 4：Journey + TransportLeg 本地路线规划（对应开发规范 §54/§55）。
// Phase 6：WorldEvent（服务器世界真相）已实现（对应规范 §56）。
// 业务模型：User / Block / RefreshToken / Letter / RecipientState / SenderState / Journey / TransportLeg / WorldEvent。
// TimelineEvent 等在 Phase 7 引入。

generator client {
  provider               = "prisma-client"
  output                 = "../generated/prisma"
  engineType             = "client"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

// 运输方式（对应开发规范 §13）
enum TransportType {
  HAND_CARRY
  HORSE_RELAY
  EXPRESS_RELAY
  PIGEON
}

// Letter 状态（对应开发规范 §37）
enum LetterStatus {
  CREATED
  DISPATCHED
  IN_TRANSIT
  AT_STATION
  TRANSFER
  DELAYED
  COURIER_MISSING
  LETTER_DROPPED
  LETTER_MISSING
  RECOVERED
  TRANSPORT_CHANGED
  OUT_FOR_DELIVERY
  DELIVERED
  PERMANENTLY_LOST
  DESTROYED
}

// 收件人阅读状态（对应开发规范 §42）
enum RecipientReadState {
  UNOPENED
  OPENED
}

// Journey 状态（Phase 4：本地 Graph 路线规划；最小状态集，后续 Phase 扩展）
enum JourneyStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// TransportLeg 状态（Phase 4：仅规划；Phase 5：正常推进 PLANNED → ACTIVE → COMPLETED）
enum TransportLegStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

// Journey 异常类型（Phase 6：World Truth；异常期间运输暂停，恢复窗口后继续或永久丢失）
enum JourneyAnomalyType {
  COURIER_MISSING
  LETTER_DROPPED
}

// WorldEvent 类型（Phase 6：服务器真实发生的世界事实；不等于用户 Timeline，不直接暴露给用户）
enum WorldEventType {
  DELAYED
  REROUTED
  ROBBERY
  COURIER_MISSING
  LOST_PATH
  LETTER_DROPPED
  SERIOUS_ACCIDENT
  RECOVERED
  TRANSPORT_CHANGED
  PERMANENTLY_LOST
  DESTROYED
}

// 用户（对应开发规范 §52）
model User {
  id           BigInt   @id @default(autoincrement())
  uid          String   @unique
  account      String   @unique
  passwordHash String
  nickname     String

  province String
  city     String
  district String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 我拉黑的用户（对应规范 §10）
  blocks Block[] @relation("Blocker")
  // 拉黑我的用户
  blockedBy Block[] @relation("Blocked")

  refreshTokens RefreshToken[]

  sentLetters     Letter[] @relation("SentLetters")
  receivedLetters Letter[] @relation("ReceivedLetters")

  recipientStates RecipientState[]
  senderStates    SenderState[]
}

// 拉黑关系（对应规范 §10）
model Block {
  id        BigInt   @id @default(autoincrement())
  blockerId BigInt
  blockedId BigInt
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id])
  blocked User @relation("Blocked", fields: [blockedId], references: [id])

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

// Refresh Token（对应规范 §5：数据库只保存 Token Hash）
model RefreshToken {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// 信件（对应开发规范 §53）
model Letter {
  id         BigInt  @id @default(autoincrement())
  trackingNo String  @unique
  senderId   BigInt
  recipientId BigInt

  // 身份快照（规范 §11）
  senderAccountSnapshot    String
  senderUidSnapshot        String
  senderNicknameSnapshot   String
  recipientAccountSnapshot String
  recipientUidSnapshot     String
  recipientNicknameSnapshot String

  // 正文加密（规范 §48：AES-256-GCM）
  encryptedContent String
  contentIv        String
  contentAuthTag   String

  // 区域快照（规范 §53）
  originProvince  String
  originCity      String
  originDistrict  String
  targetProvince  String
  targetCity      String
  targetDistrict  String

  status           LetterStatus
  initialTransport TransportType
  currentTransport TransportType

  // 幂等（规范 §67）
  clientRequestId   String
  // 请求指纹（规范化 recipient UID + content + transportType 的 SHA-256）
  requestFingerprint String

  // 版本与 Seed（规范 §53/§63/§64）
  rulesVersion   String @default("1.0")
  graphVersion   String @default("china-v1")
  simulationSeed String

  sentAt     DateTime?
  deliveredAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sender    User @relation("SentLetters", fields: [senderId], references: [id])
  recipient User @relation("ReceivedLetters", fields: [recipientId], references: [id])

  recipientState RecipientState?
  senderState    SenderState?

  // Letter : Journey = 1 : 1（对应开发规范 §54 + Phase 4 Prompt §9）
  journey Journey?

  @@unique([senderId, clientRequestId])
  @@index([recipientId])
}

// 收件人状态（对应规范 §58）
model RecipientState {
  id          BigInt             @id @default(autoincrement())
  letterId    BigInt             @unique
  recipientId BigInt
  readState   RecipientReadState
  openedAt    DateTime?
  hiddenAt    DateTime?

  letter Letter @relation(fields: [letterId], references: [id], onDelete: Cascade)
  recipient User @relation(fields: [recipientId], references: [id])

  @@index([recipientId])
}

// 发件人状态（对应规范 §59）
model SenderState {
  id       BigInt   @id @default(autoincrement())
  letterId BigInt   @unique
  senderId BigInt
  hiddenAt DateTime?

  letter Letter @relation(fields: [letterId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id])

  @@index([senderId])
}

// Journey（Phase 4：本地 Graph 路线规划结果；对应开发规范 §54 + Phase 4 Prompt）
// Letter : Journey = 1 : 1，letterId 唯一约束作为并发竞态最终保障。
model Journey {
  id         BigInt @id @default(autoincrement())
  letterId   BigInt @unique
  originNodeId      String
  destinationNodeId String

  status JourneyStatus @default(PLANNED)

  // 继承 Letter 冻结值，Journey 不得自行生成（规范 §63/§64）
  rulesVersion   String
  graphVersion   String
  simulationSeed String

  totalDistanceKm Float

  // 模拟时间语义（Phase 5：SimulationClock.now() 写入，与 createdAt/updatedAt 真实审计时间区分）。
  // 时间倒退 / 重复推进契约：now <= lastAdvancedAtSim → no-op。
  startedAtSim       DateTime? // 运输开始（首个 Leg ACTIVE 的模拟时刻）
  completedAtSim     DateTime? // 运输完成（最后一个 Leg COMPLETED 的模拟时刻，到达目标站）
  lastAdvancedAtSim  DateTime? // 最近一次推进到的模拟时刻（幂等 / 倒退判定基准）
  currentLegSequence Int?      // 当前 ACTIVE Leg 的 sequence；无 ACTIVE（未开始或已全部完成）为 null

  // 随机事件 cursor（Phase 6：单调递增，事务内消耗，replay 可重现；retry/rollback 不重复消费）
  nextEventIndex Int @default(0)

  // 异常状态（Phase 6：World Truth；运输暂停，恢复窗口后继续或 7 模拟日未恢复 → PERMANENTLY_LOST）
  anomalyType          JourneyAnomalyType?
  anomalyStartedAtSim  DateTime?
  anomalyResolvedAtSim DateTime? // 恢复计划时刻；null = 恢复窗口为 NEVER（7 日未恢复 → PERMANENTLY_LOST）
  // 续运 not-before 边界（Phase 6 Gate：SET_ASIDE 等恢复后，now < resumeAtSim 时保持 PLANNED 不激活；
  // 跨过 resumeAtSim 后从该时刻续运并清空）
  resumeAtSim DateTime?
  // last-mile 起点（Phase 6 Gate：目的站异常恢复后送达基准 = max(完成时刻, resumeAt)；持久化避免
  // OUT_FOR_DELIVERY 等待期推进退化；DELIVERED 后保持历史值）
  lastMileReadyAtSim DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  letter      Letter       @relation(fields: [letterId], references: [id], onDelete: Cascade)
  legs        TransportLeg[]
  worldEvents WorldEvent[]

  @@index([letterId])
}

// WorldEvent（Phase 6：服务器真实发生的世界事实；开发规范 §56）。
// (journeyId, eventIndex) 唯一 → 事件顺序可 replay；retry 幂等。
// nodeId / transportLegSequence：事件发生的稳定位置（Phase 7 Timeline / Phase 8 Map 直接可用，
// 不依赖按时间反推；reroute 会替换 remaining legs，故必须冻结位置字段）。
model WorldEvent {
  id                   BigInt        @id @default(autoincrement())
  journeyId            BigInt
  eventIndex           Int
  eventType            WorldEventType
  occurredAtSim        DateTime
  // 稳定位置（Phase 6 Gate 修复）：事件发生节点与 Leg 序号；生产写入路径均提供，NOT NULL 强制完整
  nodeId               String
  transportLegSequence Int?
  // 事件详情（分支/新旧运输方式/禁用边等；仅服务器内部，绝不直接暴露给用户）
  payload              Json?
  createdAt            DateTime      @default(now())

  journey Journey @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@unique([journeyId, eventIndex])
  @@index([journeyId])
}

// TransportLeg（Phase 4 路线分段；Phase 5 推进时间；Phase 6 一级事件冻结字段）。
// 不承载动态疲劳/NPC 属性；异常历史由 WorldEvent 与 Journey anomaly 字段表达。
model TransportLeg {
  id         BigInt @id @default(autoincrement())
  journeyId  BigInt
  sequence   Int
  fromNodeId String
  toNodeId   String

  transportType TransportType
  distanceKm    Float

  // Simulation 内部输入（秒），用户 API 严禁暴露（规范 §18/§45）
  plannedDurationSeconds Int

  status TransportLegStatus @default(PLANNED)

  // 模拟时间语义（Phase 5：由 SimulationClock 驱动；completed 不可回退）。
  startedAtSim   DateTime? // Leg 开始运输的模拟时刻（ACTIVE 时设置）
  completedAtSim DateTime? // Leg 完成运输的模拟时刻（COMPLETED 时设置）

  // 一级事件判定持久化（Phase 6 Gate 修复：每个 Leg 最多判定一次 primary event，DELAY 只生效一次）。
  primaryEventIndex    Int?   // 该 Leg 的 primary WorldEvent eventIndex；null = 尚未判定
  primaryEventOutcome  String? // 冻结 outcome（NORMAL/DELAY/REROUTE/ROBBERY/...；推进循环读取，不再重抽）
  delaySeconds         Int    @default(0) // DELAY 类延误（冻结；effectiveDuration = plannedDuration + delay）

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  journey Journey @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@unique([journeyId, sequence])
  @@index([journeyId])
}

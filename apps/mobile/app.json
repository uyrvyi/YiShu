{
  "expo": {
    "name": "驿书",
    "slug": "yishu",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yishu.app",
      "infoPlist": {
        "UIDesignRequiresCompatibility": false
      }
    },
    "android": {
      "package": "com.yishu.app",
      "versionCode": 2,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "允许驿书选择照片，用于信件图片和头像。",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      ["expo-location", { "locationWhenInUsePermission": "允许驿书获取所在地区，预选省、市、区。" }]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4460f42e-f176-4cda-83ba-c84bfc310d8d"
      }
    },
    "owner": "uyrvyi"
  }
}

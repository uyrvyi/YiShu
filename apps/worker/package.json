{
  "name": "@yishu/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "dev": "node --watch --import tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@yishu/db": "workspace:*",
    "@yishu/domain": "workspace:*",
    "@yishu/shared": "workspace:*",
    "@yishu/simulation": "workspace:*",
    "@yishu/config": "workspace:*",
    "bullmq": "6.3.6",
    "ioredis": "^6.0.0",
    "pino": "^9.14.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}

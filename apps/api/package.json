{
  "name": "@yishu/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node --watch --import tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/jwt": "^10.2.2",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@yishu/config": "workspace:*",
    "@yishu/db": "workspace:*",
    "@yishu/domain": "workspace:*",
    "@yishu/routing": "workspace:*",
    "@yishu/shared": "workspace:*",
    "@yishu/simulation": "workspace:*",
    "argon2": "^0.45.1",
    "fastify": "5.12.5",
    "ioredis": "^6.0.0",
    "pino": "^9.0.0",
    "sharp": "^0.35.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@yishu/worker": "workspace:*",
    "pino-pretty": "^11.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}

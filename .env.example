# 驿书 V1 环境变量示例
# 复制为 .env 并修改实际值。禁止提交 .env。

# ---- Node ----
NODE_ENV=development

# ---- API ----
API_PORT=4000
API_HOST=0.0.0.0

# ---- Database ----
# 与 docker-compose.yml 中的 POSTGRES_* 保持一致
DATABASE_URL=postgresql://yishu:yishu@localhost:5432/yishu?schema=public
# 测试专用数据库（集成测试只允许在 *_test 库执行破坏性清库）
TEST_DATABASE_URL=postgresql://yishu:yishu@localhost:5432/yishu_test?schema=public

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Auth (JWT / Refresh Token) ----
# Access Token 签名密钥；production 必须显式提供（勿用默认值）
JWT_SECRET=change-me-to-a-long-random-secret
# Access Token 有效期（秒），默认 15 分钟
JWT_EXPIRES_IN_SECONDS=900
# Refresh Token 有效期（天），默认 30 天
REFRESH_TOKEN_DAYS=30

FROM node:24-bookworm-slim

RUN npm install --global pnpm@11.22.0 @expo/ngrok@4.1.3

WORKDIR /workspace
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/mobile/package.json apps/mobile/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN --mount=type=cache,target=/pnpm/store \
    pnpm install --store-dir /pnpm/store --frozen-lockfile --ignore-scripts \
    --filter @yishu/mobile... --fetch-timeout=30000 --fetch-retries=1

COPY packages/shared/src packages/shared/src
COPY packages/shared/tsconfig.json packages/shared/tsconfig.build.json packages/shared/
RUN pnpm --filter @yishu/shared build
COPY apps/mobile/app.json apps/mobile/tsconfig.json apps/mobile/
COPY apps/mobile/assets apps/mobile/assets
COPY apps/mobile/app apps/mobile/app
COPY apps/mobile/src apps/mobile/src
RUN mkdir -p apps/mobile/.expo \
    && chown -R node:node apps/mobile/.expo /home/node

USER node
WORKDIR /workspace/apps/mobile
ENV EXPO_NO_TELEMETRY=1 EXPO_NO_DOTENV=1 CI=1
CMD ["node", "node_modules/expo/bin/cli", "start", "--host", "tunnel", "--go", "--max-workers", "1"]
